# Database & cache
DATABASE_URL=postgresql+asyncpg://cryptoquant:cryptoquant@localhost:5432/cryptoquant
REDIS_URL=redis://localhost:6379/0

# Security (Stage 8)
SECRET_KEY=                 # JWT signing + Fernet derivation
APP_PASSWORD_HASH=          # argon2 hash for single-user login

# Market data
WATCHLIST=BTCUSDT,ETHUSDT,BNBUSDT,SOLUSDT,XRPUSDT,ADAUSDT,DOGEUSDT,AVAXUSDT,LINKUSDT,DOTUSDT

# Binance keys (all optional; public market data needs none)
BINANCE_API_KEY=            # optional, read-only, Stage 8
BINANCE_API_SECRET=         # optional
BINANCE_TESTNET_API_KEY=    # optional, Stage 7
BINANCE_TESTNET_API_SECRET= # optional

# Trading — testnet is the ONLY allowed value; there is no live mode
TRADING_MODE=testnet

WHALE_THRESHOLD_USD=250000
SENTRY_DSN=                 # optional
TELEGRAM_BOT_TOKEN=         # optional, alert delivery
TELEGRAM_CHAT_ID=           # optional
ENVIRONMENT=development     # set to 'production' to refuse boot without auth configured
